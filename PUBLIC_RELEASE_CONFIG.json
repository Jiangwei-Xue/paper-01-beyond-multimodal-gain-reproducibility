{
  "schema_version": 1,
  "public_release_id": "bmg-minimal-reproduction-v1.9.0",
  "package_title": "Beyond Multimodal Gain: Minimal Reproduction Package",
  "reproduction_level": "compact-input downstream replay plus optional frozen-public-source reconstruction",
  "experiments": [
    "simulation-population",
    "simulation-finite-sample",
    "nhanes-observable-witness",
    "nhanes-boundary-and-floor-diagnostics",
    "crosscheck-observable-witness",
    "meld-primary-and-secondary"
  ],
  "entry_points": {
    "package_validation": "python3 analysis/verify_static_package.py --root .",
    "full_downstream_reproduction": "TZ=UTC make verify-full",
    "archive_validation": "python3 tools/VERIFY_ARCHIVE.py verify --archive <ARCHIVE_PATH> --public",
    "rebuild_inputs": ".venv-meld/bin/python upstream/rebuild_inputs.py --offline",
    "upstream_to_paper": ".venv-meld/bin/python upstream/run_from_rebuilt.py"
  },
  "result_map": "manuscript_binding/PAPER_RESULTS_MAP.json",
  "experiment_manifest": "config/EXPERIMENT_MANIFEST.json",
  "public_artifact_manifest": "provenance/PUBLIC_RELEASE_MANIFEST.jsonl",
  "scientific_boundaries": [
    "MELD starts from published MM-Align sequence features; neural extraction from raw audio/video is not covered.",
    "NHANES PAXRAW aggregation and joins to public survey/mortality files are executable after external source acquisition.",
    "CrossCheck starts from the public cleaned daily table; raw phone-sensor cleaning is not covered.",
    "Large upstream files are downloaded separately and are not redistributed in this archive."
  ],
